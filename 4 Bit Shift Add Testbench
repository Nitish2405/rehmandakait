`timescale 1ns/1ps//Define time unit and precision
module tbshiftadd;
reg [3:0] a_tb;
reg [3:0] b_tb;
wire [7:0] product_tb;
shiftadd dut(.a(a_tb), .b(b_tb), .product(product_tb));
initial begin
$display("Time\t a\t b\t | product(Binary) | product(Decimal)");
$display("----------------------------------------------------------------");
//Test cases
a_tb=4'b0000;b_tb=4'b0000;#10;
$display("%0dns:\t %b\t %b\t | %b\t | 
%0d",$time,a_tb,b_tb,product_tb,product_tb);
a_tb=4'b0001;b_tb=4'b0001;#10;
$display("%0dns:\t %b\t %b\t | %b\t | 
%0d",$time,a_tb,b_tb,product_tb,product_tb);
a_tb=4'b0010;b_tb=4'b0011;#10;
$display("%0dns:\t %b\t %b\t | %b\t | 
%0d",$time,a_tb,b_tb,product_tb,product_tb);
a_tb=4'b1010;b_tb=4'b0011;#10;
$display("%0dns:\t %b\t %b\t | %b\t | 
%0d",$time,a_tb,b_tb,product_tb,product_tb);
a_tb=4'b1101;b_tb=4'b0011;#10;
$display("%0dns:\t %b\t %b\t | %b\t | 
%0d",$time,a_tb,b_tb,product_tb,product_tb);
//End simulation
#10;
$stop; end endmodule
